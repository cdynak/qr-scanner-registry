# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# JWT secret from Supabase dashboard -> Settings -> API -> JWT Settings.
# Used to mint per-user tokens so Postgres Row Level Security enforces
# ownership at the database layer. Without it, the app falls back to the
# service-role client (RLS bypassed; ownership still enforced in code).
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Public Supabase Configuration (for client-side)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Application Configuration
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=your-random-secret-key
NEXTAUTH_URL=https://localhost:3000

# Public site URL (used by Astro sitemap / canonical URLs)
SITE=https://localhost:3000

# Local/offline mode: set to "true" to use an in-memory database instead of
# Supabase (no external service needed for local development).
USE_MOCK_DB=false

# Development/Testing
NODE_ENV=development
