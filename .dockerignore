# Never let secrets reach a build stage/image layer.
.env
.env.*
!.env.example

# Host-installed deps (Windows/macOS binaries) must never be copied over the
# Linux ones installed inside the build stage.
node_modules/

# Build/test output and caches — regenerated inside the image or irrelevant to it.
dist/
.astro/
.vercel/
coverage/
test-results/
playwright-report/
*.log

# Version control and editor/IDE metadata.
.git/
.gitignore
.vscode/
.idea/
.husky/

# Documentation, AI-agent config, and CI config — not needed to build or run the app.
.github/
.kiro/
.cursor/
.windsurfrules
*.md
!README.md

# Tests aren't needed to build or run the app; excluding them keeps the build
# context small (they still live fully in git, just not sent to the daemon).
e2e/
src/test/
playwright.config.ts
vitest.config.ts
lighthouserc.cjs
